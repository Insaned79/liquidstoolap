+/// Delete all persisted state for a dropped table, including its manifest.
+/// The caller must durably record DROP TABLE in the WAL before invoking this.
+pub fn delete_table_storage(dir: &Path, table_name: &str) -> Result<()> {
+    let table_dir = dir.join(table_name);
+    match std::fs::remove_dir_all(&table_dir) {
+        Ok(()) => {}
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(e) => {
+            return Err(crate::core::Error::internal(format!(
+                "failed to delete table storage {:?}: {}",
+                table_dir, e
+            )))
+        }
+    }
+    #[cfg(not(windows))]
+    if let Ok(parent) = std::fs::File::open(dir) {
+        parent.sync_all().map_err(|e| {
+            crate::core::Error::internal(format!("failed to fsync volume directory: {}", e))
+        })?;
+    }
+    Ok(())
