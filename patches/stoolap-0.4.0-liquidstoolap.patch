+/// Verify the trailing V4 checksum without allocating based on file contents.
+/// This deliberately runs before header/metadata parsing so a corrupt size field
+/// cannot cause an excessive allocation or an LZ4 decoder failure first.
+fn verify_v4_crc(path: &Path) -> Result<()> {
+    let mut file = std::fs::File::open(path)
+        .map_err(|e| crate::core::Error::internal(format!("V4 open {:?}: {}", path, e)))?;
+    let file_len = file
+        .metadata()
+        .map_err(|e| crate::core::Error::internal(format!("V4 stat {:?}: {}", path, e)))?
+        .len();
+    if file_len < 24 {
+        return Err(crate::core::Error::internal("V4: file too small"));
+    }
+
+    file.seek(SeekFrom::End(-4))
+        .map_err(|e| crate::core::Error::internal(format!("V4 checksum seek: {}", e)))?;
+    let mut crc_bytes = [0u8; 4];
+    file.read_exact(&mut crc_bytes)
+        .map_err(|e| crate::core::Error::internal(format!("V4 checksum read: {}", e)))?;
+    let stored_crc = u32::from_le_bytes(crc_bytes);
+
+    file.seek(SeekFrom::Start(0))
+        .map_err(|e| crate::core::Error::internal(format!("V4 checksum rewind: {}", e)))?;
+    let mut remaining = file_len - 4;
+    let mut hasher = crc32fast::Hasher::new();
+    let mut buffer = [0u8; 64 * 1024];
+    while remaining > 0 {
+        let to_read = remaining.min(buffer.len() as u64) as usize;
+        file.read_exact(&mut buffer[..to_read])
+            .map_err(|e| crate::core::Error::internal(format!("V4 checksum read: {}", e)))?;
+        hasher.update(&buffer[..to_read]);
+        remaining -= to_read as u64;
+    }
+    if hasher.finalize() != stored_crc {
+        return Err(crate::core::Error::internal("V4: CRC mismatch"));
+    }
+    Ok(())
+}
