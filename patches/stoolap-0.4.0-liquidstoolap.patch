+/// A manifest is a commitment to a complete immutable volume set. Recovery
+/// must reject a database when any committed file is missing or corrupt rather
+/// than silently opening with partial query results.
+fn verify_storage_integrity_rejected(dsn: &str) {
+    let error = Database::open(dsn)
+        .err()
+        .expect("corrupt committed storage must reject recovery");
+    assert!(
+        error.to_string().contains("storage integrity error"),
+        "unexpected recovery error: {error}"
+    );
+}
